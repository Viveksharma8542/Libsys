DB_HOST=localhost
DB_PORT=5432
DB_NAME=lms_db
DB_USER=postgres
DB_PASSWORD=your_password_here

JWT_SECRET=change_this_to_a_random_32_char_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_another_random_32_char_string
JWT_REFRESH_EXPIRES_IN=7d

PORT=5003
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BCRYPT_ROUNDS=10

# Email (Gmail) for hold notifications — all optional.
# Create a Gmail App Password (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.library@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM=LibSys Library <your.library@gmail.com>

# Google Sign-In: OAuth 2.0 Client ID (type: Web application) from Google Cloud Console.
# Must match REACT_APP_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Brevo HTTP email API (REQUIRED on Render free tier — SMTP ports are blocked there).
# Free signup at brevo.com (no card). Verify your Gmail as a sender, then create an API key.
# Local dev can keep using SMTP above instead.
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER=your.library@gmail.com
